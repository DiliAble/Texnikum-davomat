{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "A technical college student profile with login credentials hash, reference portrait, device lock binding, and optional 128-d face descriptor.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "groupName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "login": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-zA-Z0-9_.-]+$" },
        "passwordHash": { "type": "string", "minLength": 8, "maxLength": 128 },
        "photoUrl": { "type": "string", "maxLength": 500000 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "groupName", "login", "passwordHash", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "A verified student attendance record containing face match score, GPS distance, status, and bound device ID.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "groupName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "dateStr": { "type": "string", "minLength": 10, "maxLength": 10 },
        "timeStr": { "type": "string", "minLength": 5, "maxLength": 8 },
        "status": { "type": "string", "enum": ["Bor", "Kechikdi", "Hududdan tashqari", "Yo'q"] },
        "distanceMeters": { "type": "number" },
        "faceScore": { "type": "number" },
        "deviceId": { "type": "string", "minLength": 4, "maxLength": 128 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "syncedToSheets": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "groupName", "dateStr", "timeStr", "status", "distanceMeters", "faceScore", "deviceId", "createdAt"]
    },
    "CampusSettings": {
      "title": "CampusSettings",
      "description": "College campus GPS geofence coordinates, allowed radius, late cutoff time, and optional Google Apps Script webhook URL.",
      "type": "object",
      "properties": {
        "campusName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "allowedRadiusMeters": { "type": "number" },
        "lateAfterTime": { "type": "string", "minLength": 5, "maxLength": 5 },
        "googleSheetsWebhookUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["campusName", "lat", "lng", "allowedRadiusMeters", "lateAfterTime", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized teacher/administrator registry mapped by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin", "teacher"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student roster and device-lock profiles managed by teachers/admins."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Verified attendance check-in records."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CampusSettings" },
      "description": "Campus geofence and integration settings."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized teacher and administrator accounts."
    }
  }
}
